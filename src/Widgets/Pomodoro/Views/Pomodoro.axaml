<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locales="clr-namespace:Pomodoro.Locales"
             xmlns:viewModels="clr-namespace:Pomodoro.ViewModels"
             x:Class="Pomodoro.Views.Pomodoro"
             x:DataType="viewModels:PomodoroViewModel"
             Margin="12">
    <UserControl.Styles>
        <Style Selector="Button.pomo-button">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#AEB8BE" />
        </Style>
        <Style Selector="Path.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Opacity" Value="0.2" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Foreground" Value="#AAB5BC" />
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid IsVisible="{Binding IsSmallLayout}" RowDefinitions="Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding PhaseText}" FontSize="15" FontWeight="SemiBold" Foreground="#AEB8BE" />
                    <TextBlock Text="{Binding RunningText}" FontSize="10" Opacity="0.55" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding CycleText}"
                           Foreground="#AAB5BC"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top" />
            </Grid>
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,8">
                <TextBlock Text="{Binding TimeText}" FontSize="48" FontWeight="SemiBold" Foreground="#AAB5BC" />
            </Viewbox>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,6,0,0">
                    <Button Classes="pomo-button" Content="{Binding StartPauseText}" Foreground="#AEB8BE" Click="StartPause_OnClick" />
                    <Button Classes="pomo-button" Content="{x:Static locales:Locale.Pomodoro_Reset}" Click="Reset_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsMediumLayout}" ColumnDefinitions="1.25*,Auto,1*" RowDefinitions="*">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PhaseText}" FontSize="15" FontWeight="SemiBold" Foreground="#AEB8BE" />
                <TextBlock Text="{Binding TimeText}" FontSize="46" FontWeight="SemiBold" Foreground="#AAB5BC" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
            </StackPanel>
            <Path Grid.Column="1" Width="1" Stretch="Fill" Opacity="0.2" StrokeThickness="1.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="12,0">
                <Path.Data>
                    <LineGeometry StartPoint="0,0" EndPoint="0,1" />
                </Path.Data>
            </Path>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding CycleText}" FontSize="22" FontWeight="SemiBold" Foreground="#AAB5BC" />
                <TextBlock Text="{Binding CompletedText}" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="pomo-button" Content="{Binding StartPauseText}" Foreground="#AEB8BE" Click="StartPause_OnClick" />
                    <Button Classes="pomo-button" Content="{x:Static locales:Locale.Pomodoro_Skip}" Click="Skip_OnClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsLargeLayout}" RowDefinitions="Auto,*,Auto,Auto">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="SemiBold" Foreground="#AEB8BE" />
                    <TextBlock Text="{Binding RunningText}" FontSize="11" Opacity="0.55" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding CycleText}"
                           Foreground="#AAB5BC"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,10">
                <TextBlock Text="{Binding TimeText}" FontSize="64" FontWeight="SemiBold" Foreground="#AAB5BC" />
            </Viewbox>
            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,0,0,8" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding CompletedText}" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <Button Classes="pomo-button" Content="{Binding StartPauseText}" Foreground="#AEB8BE" Click="StartPause_OnClick" />
                    <Button Classes="pomo-button" Content="{x:Static locales:Locale.Pomodoro_Reset}" Click="Reset_OnClick" />
                    <Button Classes="pomo-button" Content="{x:Static locales:Locale.Pomodoro_Skip}" Click="Skip_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsExtraLargeLayout}" ColumnDefinitions="1.35*,Auto,0.85*,Auto,0.85*" RowDefinitions="Auto,*">
            <Grid Grid.ColumnSpan="5" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding PhaseText}" FontSize="18" FontWeight="SemiBold" Foreground="#AEB8BE" />
                    <TextBlock Text="{Binding RunningText}" FontSize="12" Opacity="0.55" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="pomo-button" Content="{Binding StartPauseText}" Foreground="#AEB8BE" Click="StartPause_OnClick" />
                    <Button Classes="pomo-button" Content="{x:Static locales:Locale.Pomodoro_Reset}" Click="Reset_OnClick" />
                    <Button Classes="pomo-button" Content="{x:Static locales:Locale.Pomodoro_Skip}" Click="Skip_OnClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="0,0,12,0">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding TimeText}" FontSize="76" FontWeight="SemiBold" Foreground="#AAB5BC" />
                </Viewbox>
                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,12,0,0" />
            </Grid>

            <Path Grid.Column="1" Grid.Row="1" Width="1" Stretch="Fill" Opacity="0.2" StrokeThickness="1.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,12,0">
                <Path.Data>
                    <LineGeometry StartPoint="0,0" EndPoint="0,1" />
                </Path.Data>
            </Path>

            <StackPanel Grid.Column="2" Grid.Row="1" Spacing="8" Margin="0,0,12,0">
                <TextBlock Text="Cycle" FontSize="12" Opacity="0.55" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CycleText}" FontSize="34" FontWeight="SemiBold" Foreground="#AAB5BC" />
                <TextBlock Text="{Binding CompletedText}" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                <Path Classes="divider" Margin="0,3">
                    <Path.Data>
                        <LineGeometry StartPoint="0,0" EndPoint="1,0" />
                    </Path.Data>
                </Path>
                <TextBlock Text="Next" FontSize="12" Opacity="0.55" />
                <TextBlock Text="{Binding NextPhaseText}" FontSize="16" FontWeight="SemiBold" Foreground="#AEB8BE" />
            </StackPanel>

            <Path Grid.Column="3" Grid.Row="1" Width="1" Stretch="Fill" Opacity="0.2" StrokeThickness="1.5" Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}" Margin="0,0,12,0">
                <Path.Data>
                    <LineGeometry StartPoint="0,0" EndPoint="0,1" />
                </Path.Data>
            </Path>

            <StackPanel Grid.Column="4" Grid.Row="1" Spacing="8">
                <TextBlock Text="Durations" FontSize="12" Opacity="0.55" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FocusDurationText}" FontWeight="SemiBold" Foreground="#AEB8BE" />
                <TextBlock Text="{Binding ShortBreakDurationText}" Opacity="0.65" />
                <TextBlock Text="{Binding LongBreakDurationText}" Opacity="0.65" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
