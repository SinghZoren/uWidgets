<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WidgetBackground" Color="White" Opacity="{DynamicResource BackgroundOpacity}" />
            <SolidColorBrush x:Key="WidgetStrokeBrush" Color="Transparent" />
            <Thickness x:Key="WidgetStrokeThickness">0</Thickness>
            <SolidColorBrush x:Key="SettingsBackground" Color="{DynamicResource SystemChromeLowColor}" />
            <x:Double x:Key="TextOpacity">0.82</x:Double>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="TextBlock">
        <Setter Property="Opacity" Value="0.82" />
    </Style>
</Styles>
